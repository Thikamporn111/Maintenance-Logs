# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project -> Settings -> Environment Variables.

# ── Supabase Auth & Database (Required) ──────────────────────────────────────
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side only. Bypasses Row Level Security — never expose to the client,
# never commit, never paste in group chat.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Session Secret (Required) ────────────────────────────────────────────────
# Random string, 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Demo accounts fallback (Optional) ────────────────────────────────────────
# For offline development only, when Supabase is not configured.
# Set DEMO_PASSWORD (12+ characters) to enable mock accounts.
# On production ALWAYS set DEMO_LOGIN=off and leave DEMO_PASSWORD empty.
DEMO_LOGIN=off
DEMO_PASSWORD=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Not read by this app. Google credentials are configured in
# Supabase Dashboard -> Authentication -> Providers -> Google.
# In Google Cloud Console, the authorized redirect URI must be:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
