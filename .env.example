# Copy to .env.local for local development. Never commit real values.

# Required in production (Vercel): random string, 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Demo sign-in for the development team only (mock data layer). There is NO password in the code:
# set DEMO_PASSWORD (12+ characters) to enable the demo accounts, or DEMO_LOGIN=off to disable them.
# Share it privately within the team and never commit it. There is no registration until Supabase Auth is added.
DEMO_LOGIN=
DEMO_PASSWORD=

# ── Supabase (to be added by the team) ──────────────────────────────────────
# Only the URL and the anon/publishable key may use the NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service role / secret key must stay server-only (no NEXT_PUBLIC_ prefix) and should rarely be needed.
# SUPABASE_SERVICE_ROLE_KEY=
